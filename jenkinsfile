pipeline {
    agent any

    environment {
        REMOTE_HOST = "ubuntu@18.205.222.76"
        SSH_KEY = credentials('lightsail-ssh') // SSH key must be added in Jenkins credentials
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'dev', url: 'https://github.com/SASowah/flask-monitoring.git'
            }
        }

      stage('Run Ansible Playbook') {
    steps {
        sshagent(['lightsail-ssh']) {
            sh 'ansible-playbook -i inventory/hosts.ini ansible/site.yml
                }
            }
        }
    }

    post {
        success {
            echo "✅ Lightsail deployment via Ansible completed successfully."
        }
        failure {
            echo "❌ Deployment failed. Check Ansible logs."
        }
    }
}
