pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "samsow/flask-monitoring"
        DOCKER_CREDENTIALS_ID = 'docker-hub-creds'
        REMOTE_HOST = "ubuntu@18.205.222.76"
        SSH_KEY = credentials('lightsail-ssh')
        BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'dev', url: 'https://github.com/SASowah/flask-monitoring.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}", "ansible/roles/flask_app/files")
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDENTIALS_ID) {
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}").push()
                    }
                }
            }
        }

        stage('Deploy Docker Container to Lightsail') {
            steps {
                sshagent(['lightsail-ssh']) {
                    sh """#!/bin/bash
ssh -o StrictHostKeyChecking=no ${REMOTE_HOST} << 'ENDSSH'
docker pull ${DOCKER_IMAGE}:${BUILD_NUMBER}
docker stop flask-monitor || true
docker rm flask-monitor || true
docker run -d --name flask-monitor -p 5000:5000 ${DOCKER_IMAGE}:${BUILD_NUMBER}
ENDSSH
"""
                }
            }
        }

        stage('Run Ansible Playbook') {
            steps {
                sshagent(['lightsail-ssh']) {
                    sh 'ansible-playbook -i inventory/hosts.ini ansible/site.yml'
                }
            }
        }
    }

    post {
        success {
            echo "✅ Full CI/CD pipeline executed successfully!"
        }
        failure {
            echo "❌ Deployment failed. Check logs for details."
        }
    }
}
