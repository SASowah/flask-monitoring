pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "samsow/flask-monitoring"
        DOCKER_CREDENTIALS_ID = 'docker-hub-creds'
        REMOTE_HOST = "ubuntu@18.205.222.76"
        SSH_KEY = credentials('lightsail-ssh') // Make sure this is correctly configured
        BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'dev', url: 'https://github.com/SASowah/flask-monitoring.git'
            }
        }
    }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}", "ansible/roles/flask_app/files")
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                    script {
                        docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDENTIALS_ID) {
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}").push()
                    }
                }
            }
        }

        stage('Deploy to Lightsail') {
    steps {
        sshagent(['ubuntu']) {
            sh '''#!/bin/bash
ssh -o StrictHostKeyChecking=no ubuntu@18.205.222.76 << 'ENDSSH'
docker pull samsow/flask-monitoring:14
docker stop flask-monitor || true
docker rm flask-monitor || true
docker run -d --name flask-monitor -p 80:5000 samsow/flask-monitoring:14
ENDSSH
            '''
        }
    }
}

    post {
        success {
            echo "✅ Deployment successful!"
        }
        failure {
            echo "❌ Deployment failed!"
        }
    }
}